  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
